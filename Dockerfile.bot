FROM python:3.12-slim-bookworm
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 MPLBACKEND=Agg PYTHONPATH=/app/src
RUN pip install --no-cache-dir torch==2.7.1 --index-url https://download.pytorch.org/whl/cpu
COPY docker/bot-requirements.txt /app/docker/bot-requirements.txt
RUN pip install --no-cache-dir -r /app/docker/bot-requirements.txt
COPY src /app/src
COPY pyproject.toml sgbaseimg_70km.png /app/
COPY scripts/run_bot_service.py /app/scripts/run_bot_service.py
RUN python -m compileall -q /app/src /app/scripts
ENTRYPOINT ["python", "-u", "/app/scripts/run_bot_service.py"]
