# Copy to .env and replace placeholders. Never commit the real .env.
tele_api_key=YOUR_TELEGRAM_BOT_TOKEN
gov_api_key=YOUR_GOVSG_API_KEY
MYSQLHOST=localhost
MYSQLUSER=weatherbot
# Used as the password for MYSQLUSER, despite this variable's historical name.
MYSQL_ROOT_PASSWORD=YOUR_DATABASE_PASSWORD
MYSQL_DATABASE=WeatherBot

# Docker Compose uses this instead of MYSQLHOST for an existing host database.
BOT_MYSQL_HOST=host.docker.internal

# Optional: complete secret Uptime Kuma push URL; leave blank to disable.
KUMA_PUSH_URL=

# /weather uses the public NEA/MSS forecast API and needs no extra key.
